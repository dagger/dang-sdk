"""
Manage Dagger modules that use the built-in Dang SDK.
"""
type DangSdk {
  """
  Template used when a new Dang module is initialized.
  """
  template: String! = "minimal"

  """
  Marker filename that skips generate when found at or above a Dang SDK module root.
  """
  skipGenerateFilename: String! = ".dagger-dang-sdk-skip-generate"

  """
  Detect the nearest Dang module that contains Workspace.cwd.
  """
  detectScope(ws: Workspace!): String! {
    let found = ws.findUp("dagger-module.toml")
    if (found == null) {
      ""
    } else {
      let base = configDir(found, "dagger-module.toml")
      let runtime = ws.moduleSource("/" + base).sdk.source rescue { err: Error => "" }
      if (runtime == "dang") { base } else { "" }
    }
  }

  """
  Generate one Dang SDK scope.

  A new module gets current and legacy manifests plus starter source. Existing
  module source is preserved. Module clients are stored as dependencies because
  the built-in Dang runtime does not generate client files.
  """
  generateScope(
    ws: Workspace!,
    isModule: Boolean!,
    name: String!,
    clients: [ModuleSource!]!,
  ): Workspace! {
    let initialized = if (exists(ws, "dagger-module.toml")) {
      ws
    } else if (!isModule) {
      ws
    } else if (!currentModule.source.exists("templates/" + template)) {
      raise "unknown init template: " + template
    } else {
      ws
        .withDirectory(
          ".",
          moduleManifest
            .withName(name)
            .withLegacyDangRuntime
            .directory,
        )
        .withDirectory(".", renderedTemplate(name, template))
    }

    if (!exists(initialized, "dagger-module.toml")) {
      if (clients.length > 0) {
        raise "Dang clients require a Dang module in the scope"
      } else {
        initialized
      }
    } else {
      withClients(initialized, clients)
    }
  }

  """
  Return true when a path exists in Workspace.cwd.
  """
  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  """
  Replace the module dependency set with the complete client set.
  """
  let withClients(ws: Workspace!, clients: [ModuleSource!]!): Workspace! {
    let loaded = if (exists(ws, "dagger.json")) {
      moduleManifest(
        loadTOML: ws.file("dagger-module.toml"),
        loadJSON: ws.file("dagger.json"),
      )
    } else {
      moduleManifest(loadTOML: ws.file("dagger-module.toml"))
    }
    let configured = clients.{{moduleName, kind, sourceRootSubpath, asString, pin}}
      .reduce(loaded.withoutDependencies) { manifest, client =>
        manifest.withDependency(
          source: dependencySource(
            ws.cwd,
            client.kind,
            client.sourceRootSubpath,
            client.asString,
          ),
          name: client.moduleName,
          pin: client.pin,
        )
      }

    ws.withDirectory(".", configured.directory)
  }

  """
  Return the dependency source to write for a client.
  """
  let dependencySource(
    scopePath: String!,
    kind: ModuleSourceKind!,
    sourceRootSubpath: String!,
    ref: String!,
  ): String! {
    if (kind == ModuleSourceKind.GIT_SOURCE) {
      ref
    } else {
      relativePath(scopePath, sourceRootSubpath)
    }
  }

  """
  Return a path from one workspace directory to another.
  """
  let relativePath(from: String!, to: String!): String! {
    relativePathParts(pathParts(from), pathParts(to))
  }

  let pathParts(path: String!): [String!]! {
    let normalized = normalizePath(path)
    if (normalized == ".") { [] } else { normalized.split("/") }
  }

  let relativePathParts(from: [String!]!, to: [String!]!): String! {
    if (!from.isEmpty and !to.isEmpty and from.takeFirst.join("") == to.takeFirst.join("")) {
      relativePathParts(from.dropFirst, to.dropFirst)
    } else {
      let relative = (from.map { segment => ".." } + to).join("/")
      if (relative == "") { "." } else { relative }
    }
  }

  """
  Return a valid workspace-root-relative path, "." at the root.
  """
  let normalizePath(path: String!): String! {
    let trimmed = path.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (trimmed == "") { "." } else { trimmed }
  }

  """
  Return the directory holding a config file: "a/b/dagger.json" -> "a/b",
  "dagger.json" -> ".".
  """
  let configDir(path: String!, filename: String!): String! {
    normalizePath(path.trimPrefix("/").trimSuffix(filename))
  }

  """
  Return the depth of a workspace-root-relative path, 0 at the root, -1 for null.
  """
  let pathDepth(path: String): Int! {
    if (path == null) { -1 } else if (path == ".") { 0 } else { path.split("/").length }
  }

  """
  Return init templates tracked by this module.

  Templates live under templates/<name> and are materialized into the new
  module. Passing an empty template to init uses the module default.
  """
  templates: [Template!]! {
    if (currentModule.source.exists("templates")) {
      let root = currentModule.source.directory("templates")
      root.entries.map { name =>
        Template(
          name: name.trimSuffix("/"),
          source: root.directory(name),
        )
      }
    } else {
      directory.entries.map { name =>
        Template(
          name: name,
          source: directory,
        )
      }
    }
  }

  """
  Return the Dang SDK module at or above a workspace path.

  When `findUp` is true, `path` may point inside the module. Both the legacy
  dagger.json and the CLI 1.0 dagger-module.toml are recognized; when a
  partially migrated tree holds both, the nearest config wins.
  """
  mod(ws: Workspace!, path: String! = ".", findUp: Boolean! = true): Mod! {
    let modPath = if (findUp) {
      let foundToml = ws.findUp("dagger-module.toml", path)
      let foundJson = ws.findUp("dagger.json", path)
      let tomlBase = if (foundToml == null) { null } else {
        configDir(
          foundToml,
          "dagger-module.toml",
        )
      }
      let jsonBase = if (foundJson == null) { null } else {
        configDir(
          foundJson,
          "dagger.json",
        )
      }

      if (tomlBase == null and jsonBase == null) {
        raise "no Dagger module found containing path: " + path
      } else if (tomlBase != null and pathDepth(tomlBase) >= pathDepth(jsonBase)) {
        validateConfig(ws, tomlBase, path)
      } else if (jsonBase != null) {
        validateConfig(ws, jsonBase, path)
      } else {
        raise "no Dagger module found containing path: " + path
      }
    } else {
      normalizePath(path)
    }

    Mod(
      rootPath: modPath,
      ws: ws,
      skipGenerateFilename: skipGenerateFilename,
    )
  }

  """
  Confirm the module at `base` declares the Dang runtime, returning `base`, or
  raise naming the requested path when it does not.

  The engine parses whichever config format the module uses, so this reads the
  declared runtime rather than searching either file's text.
  """
  let validateConfig(ws: Workspace!, base: String!, requestedPath: String!): String! {
    # A config that declares no runtime at all has no sdk to read, so treat an
    # unreadable runtime the same as a foreign one.
    let runtime = ws.moduleSource("/" + base).sdk.source rescue { err: Error => "" }
    if (runtime == "dang") {
      base
    } else {
      raise "Dagger module does not use the Dang SDK: " + requestedPath
    }
  }

  """
  Render a Dang template with the requested module name.
  """
  let renderedTemplate(name: String!, templateName: String!): Directory! {
    container
      .from("golang:1.25-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helper", currentModule.source.directory("helpers/render-template"))
      .withDirectory("/template", currentModule.source.directory("templates/" + templateName))
      .withWorkdir("/helper")
      .withExec(["go", "build", "-o", "/usr/local/bin/render-template", "."])
      .withExec(["render-template", name, "/template", "/rendered"])
      .directory("/rendered")
  }

}
