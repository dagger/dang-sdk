"""
Manage Dagger modules that use the built-in Dang SDK.
"""
type DangSdk {
  """
  Template used when a new Dang module is initialized.
  Available templates: minimal.
  """
  template: String! = "minimal"

  """
  Generate a fat module that includes dagger.json for older engines.
  By default, generated modules require Dagger v1.0.0-beta.3 or later.
  """
  fat: Boolean! = false

  """Write selected Git commits as manifest pins."""
  lock: Boolean! = false

  """
  Find the nearest Dang module root for client generation from Workspace.cwd.
  """
  findClientRoot(ws: Workspace!): String {
    let found = ws.findUp("dagger-module.toml")
    if (found == null) {
      null
    } else {
      let base = configDir(found, "dagger-module.toml")
      let runtime = ws.moduleSource("/" + base).sdk.source rescue { err: Error => "" }
      if (runtime == "dang") { base } else { null }
    }
  }

  """
  Generate one Dang SDK scope.

  A new module gets current and legacy manifests plus starter source. Existing
  module source is preserved. Module clients are stored as dependencies because
  the built-in Dang runtime does not generate client files.
  """
  generateScope(
    ws: Workspace!,
    isModule: Boolean!,
    name: String!,
    clients: [ModuleSource!]!,
  ): Workspace! {
    let hasManifest = exists(ws, "dagger-module.toml")
    let initialized = if (hasManifest) {
      ws
    } else if (!isModule) {
      ws
    } else {
      ws.withNewFile("main.dang", renderTemplate(name, template))
    }

    if (!hasManifest and !isModule) {
      if (clients.length > 0) {
        raise "Dang clients require a Dang module in the scope"
      } else {
        initialized
      }
    } else {
      generateScopeClients(initialized, name, clients)
    }
  }

  """
  Return true when a path exists in Workspace.cwd.
  """
  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  """
  Replace the module dependency set with the complete client set.

  Other fields of an existing manifest are kept.
  """
  let generateScopeClients(ws: Workspace!, name: String!, clients: [ModuleSource!]!): Workspace! {
    sdkHelpers.loadModuleManifest(ws)
      .withName(name)
      .withLegacyDangRuntime
      .withLegacyRuntimeDependencies(modules: clients)
      .generate(ws, lock: lock, legacyJson: fat)
  }

  """
  Return a valid workspace-root-relative path, "." at the root.
  """
  let normalizePath(path: String!): String! {
    let trimmed = path.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (trimmed == "") { "." } else { trimmed }
  }

  """
  Return the directory holding a config file: "a/b/dagger.json" -> "a/b",
  "dagger.json" -> ".".
  """
  let configDir(path: String!, filename: String!): String! {
    normalizePath(path.trimPrefix("/").trimSuffix(filename))
  }

  """
  Return the depth of a workspace-root-relative path, 0 at the root, -1 for null.
  """
  let pathDepth(path: String): Int! {
    if (path == null) { -1 } else if (path == ".") { 0 } else { path.split("/").length }
  }

  """
  Return the Dang SDK module at or above a workspace path.

  When `findUp` is true, `path` may point inside the module. Both the legacy
  dagger.json and the CLI 1.0 dagger-module.toml are recognized; when a
  partially migrated tree holds both, the nearest config wins.
  """
  mod(ws: Workspace!, path: String! = ".", findUp: Boolean! = true): Mod! {
    let modPath = if (findUp) {
      let foundToml = ws.findUp("dagger-module.toml", path)
      let foundJson = ws.findUp("dagger.json", path)
      let tomlBase = if (foundToml == null) { null } else {
        configDir(
          foundToml,
          "dagger-module.toml",
        )
      }
      let jsonBase = if (foundJson == null) { null } else {
        configDir(
          foundJson,
          "dagger.json",
        )
      }

      if (tomlBase == null and jsonBase == null) {
        raise "no Dagger module found containing path: " + path
      } else if (tomlBase != null and pathDepth(tomlBase) >= pathDepth(jsonBase)) {
        validateConfig(ws, tomlBase, path)
      } else if (jsonBase != null) {
        validateConfig(ws, jsonBase, path)
      } else {
        raise "no Dagger module found containing path: " + path
      }
    } else {
      normalizePath(path)
    }

    Mod(
      rootPath: modPath,
      ws: ws,
    )
  }

  """
  Confirm the module at `base` declares the Dang runtime, returning `base`, or
  raise naming the requested path when it does not.

  The engine parses whichever config format the module uses, so this reads the
  declared runtime rather than searching either file's text.
  """
  let validateConfig(ws: Workspace!, base: String!, requestedPath: String!): String! {
    # A config that declares no runtime at all has no sdk to read, so treat an
    # unreadable runtime the same as a foreign one.
    let runtime = ws.moduleSource("/" + base).sdk.source rescue { err: Error => "" }
    if (runtime == "dang") {
      base
    } else {
      raise "Dagger module does not use the Dang SDK: " + requestedPath
    }
  }

  """
  Convert a module name to the type name used by its main object.
  """
  let moduleTypeName(name: String!): String! {
    name
      .splitMatches(`[-_. ]+`)
      .filter { word => word != "" }
      .map { word =>
        let characters = word.split("")
        characters.takeFirst.join("").toUpper + characters.dropFirst.join("")
      }
      .join("")
  }

  """
  Render a starter source file for a new Dang module.
  """
  let renderTemplate(name: String!, templateName: String!): String! {
    if (templateName != "minimal") {
      raise "unknown init template: " + templateName
    }

    let moduleType = moduleTypeName(name)
    ````dang
    """
    Starter Dang module generated by dang-sdk.
    """
    type ${moduleType} {
      """
      Activate chaos mode.
      """
      chaosMode: Boolean! = false

      """
      Base container for the test environment.
      """
      base: Container! = container
        .from("alpine:3.22.1")
        .withExec(["apk", "add", "--no-cache", "curl"])

      """
      Check this module.
      """
      pub myCheck: Void @check {
        if (chaosMode) {
          raise "chaos mode!"
        }
        null
      }

      """
      Return a shell environment with test scripts and the backend service.
      """
      pub myTestEnv(ws: Workspace!): Container! {
        base
          .withWorkdir("/work")
          .withMountedDirectory(
            ".",
            ws.directory(".", include: ["**/my-tests.sh"]),
          )
          .withServiceBinding("my-backend", backend)
          .withDefaultTerminalCmd(["/bin/sh"])
      }

      """
      Start a small web backend.
      """
      @up
      pub myBackend: Service! {
        backend
      }

      """
      Generate an example backend test.
      """
      pub myGenerate(ws: Workspace!): Changeset! @generate {
        ws.withNewFile(
          "my-tests.sh",
          ```sh
          #!/bin/sh
          set -eu

          test "$(curl --fail --silent http://my-backend)" = "hello"
          echo "OK"
          ```,
        ).changes(ws)
      }

      """
      Build the backend service used by the test environment.
      """
      let backend: Service! {
        container
          .from("nginx:alpine")
          .withNewFile("/usr/share/nginx/html/index.html", "hello\n")
          .withExposedPort(80)
          .asService
      }
    }
    ````
  }
}
