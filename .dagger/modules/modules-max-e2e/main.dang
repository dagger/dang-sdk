"""
Validate the development Dang SDK with the modules-max engine.
"""
type ModulesMaxE2e {
  let engineRepository: String! = "https://github.com/dagger/dagger"
  let engineRef: String! = "sdk-ux-module-max"
  let modulePath: String! = ".tmp/modules-max-smoke"

  """
  The modules-max engine should recognize this SDK, initialize a module, and
  load and call the generated module.
  """
  devSdkCheck(ws: Workspace!): Void @check {
    let engineWs = git(engineRepository)
      .branch(engineRef)
      .asWorkspace
    let sdkSource = ws.directory("/", exclude: [".git/**", ".tmp/**"])
    let testWorkspace = directory
      .withDirectory("dang-sdk", sdkSource)
      .withNewFile(
        "dagger.toml",
        "[modules.dang-sdk]\n" +
        "source = \"dang-sdk\"\n\n" +
        "[sdks.dang]\n" +
        "module = \"dang-sdk\"\n",
      )
      .withNewFile(
        "target/dagger-module.toml",
        "name = \"target\"\n" + "engineVersion = \"v1.0.0-0\"\n\n" + "[runtime]\n" + "  source = \"dang\"\n",
      )
      .withNewFile("target/main.dang", "type Target { value: String! { \"target\" } }\n")
      .withNewFile(
        "manifest-test/dagger-module.toml",
        "name = \"manifest-test\"\n" + "engineVersion = \"v1.0.0-0\"\n\n" + "[runtime]\n" + "  source = \"dang\"\n\n" + "[[dependencies]]\n" + "  name = \"dang-sdk\"\n" + "  source = \"../dang-sdk\"\n",
      )
      .withNewFile(
        "manifest-test/main.dang",
        "type ManifestTest {\n" +
        "  clientManifestCheck(ws: Workspace!): Void @check {\n" +
        "    let scoped = ws.withDirectory(\"/scope\", directory).withWorkdir(\"scope\")\n" +
        "    let target = ws.moduleSource(\"/target\")\n" +
        "    let generated = dangSdk.generateScope(scoped, isModule: true, name: \"scope\", clients: [target])\n" +
        "    let current = generated.file(\"dagger-module.toml\").contents\n" +
        "    let legacy = generated.file(\"dagger.json\").contents\n" +
        "    assert(\"client missing from dagger-module.toml: \\n\" + current) { current.contains(\"target\") }\n" +
        "    assert(\"client missing from dagger.json: \\n\" + legacy) { legacy.contains(\"target\") }\n" +
        "    let removed = dangSdk.generateScope(generated, isModule: true, name: \"scope\", clients: [])\n" +
        "    assert(\"client remained in dagger-module.toml\") { !removed.file(\"dagger-module.toml\").contents.contains(\"target\") }\n" +
        "    assert(\"client remained in dagger.json\") { !removed.file(\"dagger.json\").contents.contains(\"target\") }\n" +
        "    null\n" +
        "  }\n" +
        "}\n",
      )
    let initialized = engineDev(ws: engineWs)
      .playground
      .withDirectory("/work", testWorkspace)
      .withWorkdir("/work")
      .withExec(["git", "init", "--quiet"])
      .withExec([
        "dagger",
        "-W",
        ".",
        "-y",
        "module",
        "init",
        "dang",
        "--name",
        "modules-max-smoke",
        "--path",
        modulePath,
      ])

    assert("module init did not write dagger-module.toml") {
      initialized.exists("/work/" + modulePath + "/dagger-module.toml")
    }
    assert("module init did not write dagger.json") {
      initialized.exists("/work/" + modulePath + "/dagger.json")
    }

    let verified = initialized.withExec([
      "dagger",
      "-W",
      ".",
      "-m",
      "manifest-test",
      "check",
    ])
    let output = verified
      .withExec(["dagger", "-W", ".", "-m", modulePath, "call", "hello"])
      .stdout
      .trimSuffix("\n")
    assert("generated module returned an unexpected result: " + output) {
      output == "hello from Dang"
    }

    null
  }
}
