"""
Run the Dang SDK end-to-end suite on a development engine.
"""
type E2e {
  """
  Git ref used to build the target engine.
  """
  targetEngineRef: String! = "sdk-ux-module-max"

  let engineRepository: String! = "https://github.com/dagger/dagger"
  let modulePath: String! = ".tmp/e2e-module"

  """
  A target engine holding the development SDK as the workspace `dang` SDK.
  """
  let playground(ws: Workspace!): Container! {
    let engineWs = git(engineRepository)
      .branch(targetEngineRef)
      .asWorkspace
    let sdkSource = ws.directory("/", exclude: [".git", ".git/**", ".tmp/**"])
    let testWorkspace = sdkSource.withNewFile(
      "dagger.toml",
      ```toml
      [modules.dang-sdk]
      source = "."

      [modules.e2e-suite]
      source = ".dagger/modules/e2e/suite"

      [sdks.dang]
      module = "dang-sdk"

      [sdks.dang.scopes.".dagger/modules/e2e/fixtures/lookup-toml/app"]
      is-module = true
      name = "lookup-toml-app"
      ```,
    )
    engineDev(ws: engineWs)
      .playground
      .withDirectory("/work", testWorkspace)
      .withWorkdir("/work")
      .withExec(["git", "init", "--quiet"])
  }

  """
  The target engine should initialize, load, and test the development Dang SDK.
  """
  devSdkCheck(ws: Workspace!): Void @check {
    let initialized = playground(ws)
      .withExec([
        "dagger",
        "-W",
        ".",
        "-y",
        "module",
        "init",
        "dang",
        "--name",
        "e2e-module",
        "--path",
        modulePath,
      ])

    assert("module init did not write dagger-module.toml") {
      initialized.exists("/work/" + modulePath + "/dagger-module.toml")
    }
    assert("module init wrote dagger.json by default") {
      !initialized.exists("/work/" + modulePath + "/dagger.json")
    }

    let fat = initialized.withExec([
      "dagger",
      "-W",
      ".",
      "-y",
      "module",
      "init",
      "dang",
      "--name",
      "e2e-module",
      "--path",
      modulePath,
      "--fat",
    ])
    assert("fat generation did not create dagger.json") {
      fat.exists("/work/" + modulePath + "/dagger.json")
    }

    let thin = fat.withExec([
      "dagger",
      "-W",
      ".",
      "-y",
      "module",
      "init",
      "dang",
      "--name",
      "e2e-module",
      "--path",
      modulePath,
      "--fat=false",
    ])
    assert("thin generation did not remove dagger.json") {
      !thin.exists("/work/" + modulePath + "/dagger.json")
    }

    let verified = thin
      .withExec([
        "dagger",
        "-W",
        ".",
        "-m",
        "e2e-suite",
        "check",
      ])
      .withExec(["dagger", "-W", ".", "-m", modulePath, "-y", "call", "my-generate"])
      .withExec(["dagger", "-W", ".", "-m", modulePath, "check"])
    let output = verified
      .withExec([
        "dagger",
        "-W",
        ".",
        "-m",
        modulePath,
        "call",
        "my-test-env",
        "with-exec",
        "--args",
        "sh,e2e-module-tests.sh",
        "stdout",
      ])
      .stdout
      .trimSuffix("\n")
    assert("generated test returned an unexpected result: " + output) {
      output == "OK"
    }

    let chaos = verified.withExec(
      [
        "dagger",
        "-W",
        ".",
        "-m",
        modulePath,
        "call",
        "--chaos-mode=true",
        "my-check",
      ],
      expect: ReturnType.ANY,
    )
    assert("chaos mode check succeeded") {
      chaos.exitCode != 0
    }
    assert("chaos mode check returned the wrong error") {
      chaos.stderr.contains("chaos mode!")
    }

    null
  }

  """
  Two modules from the template should generate side by side.

  A template that writes a fixed file name collides with itself as soon as a
  workspace holds two of its modules. Mirrors the cross-SDK smoke test: init two
  modules, wire one as the other's client, then generate from inside the first.
  Generated changes land where `dagger generate` ran, so both scripts appear
  there; what matters is that the two modules no longer write the same path.
  """
  templateGenerateCheck(ws: Workspace!): Void @check {
    let generated = playground(ws)
      .withExec(["dagger", "-W", ".", "-y", "module", "init", "dang", "--name", "my-mod"])
      .withExec(["dagger", "-W", ".", "-y", "module", "init", "dang", "--name", "my-dep"])
      .withWorkdir("/work/.dagger/modules/my-mod")
      .withExec(["dagger", "-y", "module", "client", "add", "dang", "../my-dep"])
      .withExec(["dagger", "-y", "generate"])

    assert("generate did not write the module's test script") {
      generated.exists("/work/.dagger/modules/my-mod/my-mod-tests.sh")
    }
    assert("generate did not write the client module's test script") {
      generated.exists("/work/.dagger/modules/my-mod/my-dep-tests.sh")
    }

    null
  }
}
