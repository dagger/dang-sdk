type CollectionsTest {
  """Engine commit with collection projection and base state support."""
  engineRef: String! = "6fd77279fd627f6bf9e476f2a2730e0d27eef0ae"

  """SDK generation preserves collection declarations and their runtime state."""
  run(ws: Workspace!): Void @check {
    let source = ws.directory("/", exclude: [".git/**", ".tmp/**"])
    let testWorkspace = source.withNewFile("dagger.toml", ```toml
      [modules.dang-sdk]
      source = "."
      [modules.collections]
      source = ".dagger/modules/e2e/fixtures/collections"
      [sdks.dang]
      module = "dang-sdk"
      [sdks.dang.scopes.".dagger/modules/e2e/fixtures/collections"]
      is-module = true
      name = "collections"
      ```)
    let engineWs = git("https://github.com/dagger/dagger").ref(engineRef).asWorkspace
    let generated = engineDev(ws: engineWs).playground
      .withDirectory("/work", testWorkspace)
      .withWorkdir("/work")
      .withExec(["git", "init", "--quiet"])
      .withExec(["dagger", "-y", "generate"])
    let result = generated.withExec(
      ["dagger", "query", "-m", ".dagger/modules/e2e/fixtures/collections"],
      stdin: ```graphql
        { items { subset(keys: ["b"]) {
          keys
          list { name }
          batch {
            removed
            change(names: ["b", "d"]) { batch { added removed } }
            fresh { batch { added removed } }
          }
        } } }
        ```
    ).stdout
    let selected = json.withContents(result :: Dagger.JSON!).field(["items", "subset"])
    assert("subset keys changed") { strings(selected.field(["keys"])) == ["b"] }
    assert("list did not use selected keys") {
      selected.field(["list"]).asArray.{{contents}}.map { item =>
        json.withContents(item.contents).field(["name"]).asString
      } == ["b"]
    }
    let batch = selected.field(["batch"])
    assert("subset delta lost the original keys") {
      strings(batch.field(["removed"])) == ["a", "c"]
    }
    let changed = batch.field(["change", "batch"])
    assert("module key changes lost the base") {
      strings(changed.field(["added"])) == ["d"] and
      strings(changed.field(["removed"])) == ["a", "c"]
    }
    let fresh = batch.field(["fresh", "batch"])
    assert("new collection retained the old base") {
      strings(fresh.field(["added"])).length == 0 and
      strings(fresh.field(["removed"])).length == 0
    }
    null
  }

  let strings(value: JSONValue!): [String!]! {
    value.asArray.{{asString}}.map { item => item.asString }
  }
}
