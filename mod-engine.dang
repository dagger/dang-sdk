"""
Required Dagger engine version for a Dang SDK module.
"""
type ModEngine {
  """
  Workspace-relative path of the module root.
  """
  let path: String!

  """
  Workspace containing this module.
  """
  let ws: Workspace!

  """
  The Dagger engine version required by this module, without a leading "v".
  """
  required: String! {
    ws.moduleSource("/" + path).engineVersion.trimPrefix("v")
  }

  """
  Configure this module to require the given Dagger engine version.
  """
  require(version: String!): Changeset! {
    configChanges(ws, ws.moduleSource("/" + path).withEngineVersion(version))
  }

  """
  Configure this module to require the current Dagger engine version.
  """
  requireCurrent: Changeset! {
    configChanges(ws, ws.moduleSource("/" + path).withEngineVersion(version))
  }

  """
  Configure this module to require the latest stable Dagger engine version.
  """
  requireLatest: Changeset! {
    configChanges(ws, ws.moduleSource("/" + path).withEngineVersion("latest"))
  }

  """
  Stage a module source's edited dagger.json and return the change.
  """
  let configChanges(ws: Workspace!, src: ModuleSource!): Changeset! {
    ws.withNewDirectory("/", src.updatedConfigDirectory).changes(ws)
  }
}
