"""
Required Dagger engine version for a Dang SDK module.
"""
type ModEngine {
  """
  Workspace-relative path of the module root.
  """
  let path: String!

  """
  Workspace containing this module.
  """
  let ws: Workspace!

  """
  The Dagger engine version required by this module, without a leading "v".
  """
  required: String! {
    ws.moduleSource("/" + path).engineVersion.trimPrefix("v")
  }

  """
  Configure this module to require the given Dagger engine version.
  """
  require(version: String!): Changeset! {
    configChanges(ws.moduleSource("/" + path).withEngineVersion(version))
  }

  """
  Configure this module to require the exact engine version now running,
  build metadata included.
  """
  requireCurrent: Changeset! {
    configChanges(ws.moduleSource("/" + path).withEngineVersion(version))
  }

  """
  Configure this module to require the latest stable Dagger engine version.

  The engine resolves the "latest" alias while writing the config, so the
  module ends up pinned to a concrete release rather than to the alias.
  """
  requireLatest: Changeset! {
    configChanges(ws.moduleSource("/" + path).withEngineVersion("latest"))
  }

  """
  Stage a module source's edited config and return the change.
  """
  let configChanges(src: ModuleSource!): Changeset! {
    # updatedConfigDirectory carries only the config file, never the rest of the
    # module, so this has to merge rather than replace.
    ws.withDirectory("/" + path, src.updatedConfigDirectory.directory(path)).changes(ws)
  }
}
