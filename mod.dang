"""
A Dagger module that uses the built-in Dang SDK.
"""
type Mod {
  """
  Workspace-root-relative path of this module root — the module's stable
  identity, independent of where the client is invoked from.
  """
  rootPath: String!

  """
  Workspace containing this module.
  """
  let ws: Workspace!

  """
  This module root relative to the client's current location: "." when the cwd
  is the module itself, "sub/mod" for a module beneath it, ".." for an
  enclosing one. A cwd-relative view of rootPath, so listings read the way a
  shell user would.
  """
  path: String! {
    let cwd = normalizePath(ws.cwd)
    if (rootPath == cwd) {
      "."
    } else if (cwd == ".") {
      rootPath
    } else if (rootPath.trimPrefix(cwd + "/") != rootPath) {
      rootPath.trimPrefix(cwd + "/")
    } else if (rootPath == "." or cwd.trimPrefix(rootPath + "/") != cwd) {
      let rootDepth = if (rootPath == ".") { 0 } else { rootPath.split("/").length }
      cwd.split("/").dropFirst(rootDepth).map { segment => ".." }.join("/")
    } else {
      rootPath
    }
  }

  """
  Return a workspace path as a root-relative one, "." at the root.
  """
  let normalizePath(path: String!): String! {
    let trimmed = path.trimPrefix("/").trimSuffix("/")
    if (trimmed == "") { "." } else { trimmed }
  }

  """
  Manage this module's Dagger dependencies.
  """
  deps: ModDeps! {
    ModDeps(
      path: rootPath,
      ws: ws,
    )
  }

  """
  Manage the Dagger engine version required by this module.
  """
  engine: ModEngine! {
    ModEngine(
      path: rootPath,
      ws: ws,
    )
  }

  """
  Generate this module.
  """
  generate(ws: Workspace!): Changeset! {
    ws.moduleSource("/" + rootPath).generate(ws).changes(ws)
  }
}
